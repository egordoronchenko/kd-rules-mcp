#Область ОбработчикиСобытийФормы

&НаСервере
Процедура кд2_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)

	// В БСП 3.1.12 переключатель «Из файла на компьютере» недоступен, но загрузка комплекта
	// из временного хранилища в типовой форме осталась (ПередЗагрузкойПравил → ЗагрузитьКомплектПравил).
	Элемент = Элементы.Найти("ИсточникПравилИзФайла");
	Если Элемент <> Неопределено Тогда
		Элемент.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура кд2_ЗагрузитьПравилаИзФайла(Команда)

	ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
	ПараметрыЗагрузки.ИдентификаторФормы = УникальныйИдентификатор;
	ПараметрыЗагрузки.Диалог.Заголовок = НСтр("ru = 'Укажите архив с комплектом правил обмена'");
	ПараметрыЗагрузки.Диалог.Фильтр = НСтр("ru = 'Архивы ZIP (*.zip)'") + "|*.zip";
	ПараметрыЗагрузки.Диалог.МножественныйВыбор = Ложь;
	ПараметрыЗагрузки.Диалог.ПроверятьСуществованиеФайла = Истина;

	Оповещение = Новый ОписаниеОповещения("кд2_ЗагрузитьПравилаИзФайлаЗавершение", ЭтотОбъект);
	ФайловаяСистемаКлиент.ЗагрузитьФайл(Оповещение, ПараметрыЗагрузки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Продолжение процедуры кд2_ЗагрузитьПравилаИзФайла: проверяет выбранный файл
// и запускает типовую загрузку комплекта правил формы.
//
// Параметры:
//   ПомещенныйФайл - см. ФайловаяСистемаКлиент.ЗагрузитьФайл
//                  - Неопределено - пользователь отказался от выбора файла.
//   ДополнительныеПараметры - Неопределено
//
&НаКлиенте
Процедура кд2_ЗагрузитьПравилаИзФайлаЗавершение(ПомещенныйФайл, ДополнительныеПараметры) Экспорт

	Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ПомещенныйФайл.Хранение) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Ошибка передачи файла правил синхронизации данных на сервер.'"));
		Возврат;
	КонецЕсли;

	ЧастиИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПомещенныйФайл.Имя);
	Если НРег(ЧастиИмени.Расширение) <> ".zip" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Некорректный формат файла комплекта правил. Ожидается zip архив, содержащий три файла:
			|ExchangeRules.xml - правила конвертации для текущей программы;
			|CorrespondentExchangeRules.xml - правила конвертации для программы-корреспондента;
			|RegistrationRules.xml - правила регистрации для текущей программы.'"));
		Возврат;
	КонецЕсли;

	// Источник «из файла» говорит типовой загрузке взять комплект из временного хранилища, а не из макетов.
	ИсточникПравил = "ЗагруженныеИзФайла";
	ПередЗагрузкойПравил(ПомещенныйФайл.Хранение, ЧастиИмени.Имя);

КонецПроцедуры

#КонецОбласти
