{
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/ruff_on_edit.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
