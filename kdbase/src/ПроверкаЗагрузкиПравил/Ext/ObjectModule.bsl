// Проверка файла правил обмена штатной загрузкой КД (design.md, Д11).
//
// Запуск: 1С:Предприятие базы КД с /Execute этой обработки и /C "kd2check|<файл правил>|<файл протокола>".
// Правила загружаются обработкой ЗагрузкаКонвертации так же, как её форма: ЗагрузитьПравилаОбмена,
// затем Сохранить в новую конвертацию с новыми конфигурациями источника и приёмника.
// Протокол — текст UTF-8: строки «ИТОГ OK» или «ИТОГ ОШИБКА» и последняя «КОНЕЦ».
// Без метки kd2check в параметре запуска обработка ничего не делает.

#Если Клиент Тогда

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьПроверку(ПутьПравил, ПутьПротокола)

	Протокол = Новый ЗаписьТекста(ПутьПротокола, КодировкаТекста.UTF8);
	Протокол.ЗаписатьСтроку("НАЧАЛО " + Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Протокол.ЗаписатьСтроку("ПРАВИЛА " + ПутьПравил);
	ЕстьОшибка = Ложь;

	Попытка

		Загрузка = Обработки.ЗагрузкаКонвертации.Создать();
		Загрузка.ИмяФайлаПравилОбмена = ПутьПравил;
		Загрузка.ЗагрузитьПравилаОбмена();

		Конвертация = Загрузка.мКонвертация;
		Если Не Конвертация.Свойство("ВерсияФормата") Тогда
			ВызватьИсключение "Правила не прочитаны: в файле нет заголовка ПравилаОбмена";
		КонецЕсли;

		Загрузка.Источник = ЗначениеСвойства(Конвертация, "Источник");
		Загрузка.Приемник = ЗначениеСвойства(Конвертация, "Приемник");
		Загрузка.ЗагружаемаяКонвертация = ЗначениеСвойства(Конвертация, "Наименование");
		Загрузка.Сохранить(0, Истина, Истина);

		Протокол.ЗаписатьСтроку("КОНВЕРТАЦИЯ " + Загрузка.ЗагружаемаяКонвертация);
		ЗаписатьКоличества(Протокол, Загрузка.ЗагружаемаяКонвертация);

	Исключение

		ЕстьОшибка = Истина;
		Протокол.ЗаписатьСтроку("ОШИБКА " + СтрЗаменить(ОписаниеОшибки(), Символы.ПС, " "));

	КонецПопытки;

	Сообщения = ПолучитьСообщенияПользователю(Истина);
	Для Каждого Сообщение Из Сообщения Цикл
		Протокол.ЗаписатьСтроку("СООБЩЕНИЕ " + СтрЗаменить(Сообщение.Текст, Символы.ПС, " "));
	КонецЦикла;

	Протокол.ЗаписатьСтроку("ИТОГ " + ?(ЕстьОшибка, "ОШИБКА", "OK"));
	Протокол.ЗаписатьСтроку("КОНЕЦ");
	Протокол.Закрыть();

КонецПроцедуры

Функция ЗначениеСвойства(Структура, Имя)

	Значение = "";
	Структура.Свойство(Имя, Значение);
	Возврат СокрЛП(Значение);

КонецФункции

Процедура ЗаписатьКоличества(Протокол, Конвертация)

	Справочники_ = Новый Массив;
	Справочники_.Добавить("ПравилаКонвертацииОбъектов");
	Справочники_.Добавить("ПравилаВыгрузкиДанных");
	Справочники_.Добавить("ПравилаОчисткиДанных");
	Справочники_.Добавить("Алгоритмы");
	Справочники_.Добавить("Запросы");

	Для Каждого Имя Из Справочники_ Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	Справочник." + Имя + " КАК Правила
		|ГДЕ
		|	Правила.Владелец = &Конвертация
		|	И НЕ Правила.ЭтоГруппа";
		Запрос.УстановитьПараметр("Конвертация", Конвертация);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Протокол.ЗаписатьСтроку("КОЛИЧЕСТВО " + Имя + " " + Формат(Выборка.Количество, "ЧН=0; ЧГ="));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Инициализация

// Режим совместимости КД — 8.2.13: СтрРазделить нет, части параметра запуска — строки текста.
Части = СтрЗаменить(ПараметрЗапуска, "|", Символы.ПС);
Если СтрЧислоСтрок(Части) = 3 И СтрПолучитьСтроку(Части, 1) = "kd2check" Тогда
	ВыполнитьПроверку(СтрПолучитьСтроку(Части, 2), СтрПолучитьСтроку(Части, 3));
	ЗавершитьРаботуСистемы(Ложь);
КонецЕсли;

#КонецОбласти

#КонецЕсли
