<?xml version="1.0" encoding="utf-8"?>
<ПравилаОбмена>
  <ВерсияФормата>2.01</ВерсияФормата>
  <Источник>ВымышленнаяКонфигурация</Источник>
  <Приемник>ВымышленнаяКонфигурация</Приемник>
  <Параметры><Параметр Имя="Период"/></Параметры>
  <ПравилаКонвертацииОбъектов>
    <Правило>
      <Код>Должности</Код>
      <Источник>СправочникСсылка.Должности</Источник>
      <Приемник>СправочникСсылка.Должности</Приемник>
      <СинхронизироватьПоИдентификатору>true</СинхронизироватьПоИдентификатору>
      <ПродолжитьПоискПоПолямПоискаЕслиПоИдентификаторуНеНашли>true</ПродолжитьПоискПоПолямПоискаЕслиПоИдентификаторуНеНашли>
      <Свойства>
        <Свойство Поиск="true"><Источник Имя="Код" Вид="Реквизит"/><Приемник Имя="Код" Вид="Реквизит"/></Свойство>
        <Свойство><Источник Имя="Наименование" Вид="Реквизит"/><Приемник Имя="Наименование" Вид="Реквизит"/></Свойство>
        <Свойство><Источник Имя="Статус" Вид="Реквизит"/><Приемник Имя="Статус" Вид="Реквизит"/><КодПравилаКонвертации>Статусы</КодПравилаКонвертации></Свойство>
      </Свойства>
    </Правило>
    <Правило>
      <Код>Заказ</Код>
      <Источник>ДокументСсылка.Заказ</Источник><Приемник>ДокументСсылка.Заказ</Приемник>
      <СинхронизироватьПоИдентификатору>true</СинхронизироватьПоИдентификатору>
      <Свойства>
        <Свойство><Источник Имя="Номер" Вид="Реквизит"/><Приемник Имя="Номер" Вид="Реквизит"/></Свойство>
        <Свойство><Источник Имя="Должность" Вид="Реквизит"/><Приемник Имя="Должность" Вид="Реквизит"/><КодПравилаКонвертации>Должности</КодПравилаКонвертации></Свойство>
        <Группа>
          <Источник Имя="Товары" Вид="ТабличнаяЧасть"/><Приемник Имя="Товары" Вид="ТабличнаяЧасть"/>
          <Свойство><Источник Имя="Номенклатура" Вид="Реквизит"/><Приемник Имя="Номенклатура" Вид="Реквизит"/></Свойство>
        </Группа>
      </Свойства>
    </Правило>
    <Правило>
      <Код>Статусы</Код><Источник>ПеречислениеСсылка.Статусы</Источник><Приемник>ПеречислениеСсылка.Статусы</Приемник>
      <Значения>
        <Значение><Источник>Активен</Источник><Приемник>Активен</Приемник></Значение>
        <Значение><Источник>Закрыт</Источник><Приемник>Закрыт</Приемник></Значение>
      </Значения>
    </Правило>
  </ПравилаКонвертацииОбъектов>
  <ПравилаВыгрузкиДанных>
    <Правило><Код>Должности</Код><КодПравилаКонвертации>Должности</КодПравилаКонвертации><СпособОтбораДанных>СтандартнаяВыборка</СпособОтбораДанных><ОбъектВыборки>СправочникСсылка.Должности</ОбъектВыборки></Правило>
    <Правило><Код>Заказ</Код><КодПравилаКонвертации>Заказ</КодПравилаКонвертации><СпособОтбораДанных>СтандартнаяВыборка</СпособОтбораДанных><ОбъектВыборки>ДокументСсылка.Заказ</ОбъектВыборки></Правило>
  </ПравилаВыгрузкиДанных>
</ПравилаОбмена>
