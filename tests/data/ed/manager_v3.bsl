// 1023,2117,2251,2300,2730,2862; Template.txt:222,234 (в каталоге шаблона).
Функция ВерсияФорматаМенеджераОбмена() Экспорт
    Возврат "3";
КонецФункции
Процедура ЗаполнитьПравилаКонвертацииОбъектов(КомпонентыОбмена, ПравилаКонвертации, ТолькоЗаголовки = Ложь) Экспорт
    НаправлениеОбмена = КомпонентыОбмена.НаправлениеОбмена;
    ВерсияФорматаОбмена = КомпонентыОбмена.ВерсияФорматаОбмена;
    Если НаправлениеОбмена = "Получение" Тогда
        ДобавитьПКО_Заказ(ПравилаКонвертации, ВерсияФорматаОбмена, ТолькоЗаголовки);
    КонецЕсли;
КонецПроцедуры
Процедура ДобавитьПКО_Заказ(ПравилаКонвертации, ВерсияФорматаОбмена = "", ТолькоЗаголовки = Ложь)
    ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
    ПравилоКонвертации.ИмяПКО = "Заказ";
    ПравилоКонвертации.ОбъектДанных = Метаданные.Документы.Заказ;
    ПравилоКонвертации.ОбъектФормата = "Document.Order";
    ПравилоКонвертации.ПослеЗагрузкиВсехДанных = "ПКО_Заказ_ПослеЗагрузкиВсехДанных";
    Если ТолькоЗаголовки Тогда
        Возврат;
    КонецЕсли;
    СвойстваШапки = ПравилоКонвертации.Свойства;
    ДобавитьПКС(СвойстваШапки, "Номер", "Number", 0, , , "Версия120");
    СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "Товары", "Products", "", "Версия120");
    ДобавитьПКС(СвойстваТЧ, "Товар", "Product", , "Товар", "urn:example:extra", "Версия120");
КонецПроцедуры
Процедура ЗаполнитьПравилаКонвертацииПредопределенныхДанных(КомпонентыОбмена, ПравилаКонвертации) Экспорт
    Если УсловиеПримененияВыполняется("Версия120") Тогда
        ПравилоКонвертации = ПравилаКонвертации.Добавить();
        ПравилоКонвертации.ИмяПКПД = "Статусы";
        ПравилоКонвертации.ТипДанных = "ПеречислениеСсылка.Статусы";
        ПравилоКонвертации.ТипXDTO = "Status";
        ЗначенияДляОтправки = Новый Соответствие;
        ЗначенияДляПолучения = Новый Соответствие;
        ЗначенияДляОтправки.Вставить(Перечисления.Статусы.Новый, "New");
        ПравилоКонвертации.КонвертацииЗначенийПриОтправке = ЗначенияДляОтправки;
        ПравилоКонвертации.КонвертацииЗначенийПриПолучении = ЗначенияДляПолучения;
    КонецЕсли;
КонецПроцедуры
Процедура ПКО_Заказ_ПослеЗагрузкиВсехДанных(Объект)
    Объект.Записать();
КонецПроцедуры
Процедура ПередКонвертацией(КомпонентыОбмена) Экспорт
    Если Метаданные.ПараметрыСеанса.Найти("ВспомогательныеДанныеEnterpriseData") <> Неопределено Тогда
        ВерсияФорматаОбмена = КомпонентыОбмена.ВерсияФорматаОбмена;
        КэшУсловийПримененияПравил = Новый Соответствие;
        КэшУсловийПримененияПравил.Вставить("Версия120", ВерсияФорматаОбмена = "1.20.2");
        ПараметрыСеанса.ВспомогательныеДанныеEnterpriseData = КэшУсловийПримененияПравил;
    КонецЕсли;
КонецПроцедуры
Функция УсловиеПримененияВыполняется(УсловиеПрименения)
    Возврат ПараметрыСеанса.ВспомогательныеДанныеEnterpriseData.Получить(УсловиеПрименения);
КонецФункции
