&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура Дополнить(НаправлениеОбмена, ПравилаКонвертации)
	Если НаправлениеОбмена = "Получение" Тогда
		Правило = ПравилаКонвертации.Найти("Товар", "ИмяПКО");
		Если Правило <> Неопределено Тогда
			Свойство = Правило.Свойства.Найти("Комментарий", "СвойствоФормата");
			Если Свойство = Неопределено Тогда
				ДобавитьПКС(Правило.Свойства, "доп_Заметка", "Комментарий");
			КонецЕсли;
			Правило.ПередЗаписьюПолученныхДанных = "СохранитьЗначение";
			Правило.ПриКонвертацииДанныхXDTO = "Преобразовать";
		КонецЕсли;
		ДругоеПравило = ПравилаКонвертации.Найти("Другой", "ИмяПКО");
		Если ДругоеПравило <> Неопределено Тогда
			ДругоеПравило.ПередЗаписьюПолученныхДанных = "ПередЗаписью";
		КонецЕсли;
	ИначеЕсли НаправлениеОбмена = "Отправка" Тогда
		Правило = ПравилаКонвертации.Найти("Товар", "ИмяПКО");
		Если Правило <> Неопределено Тогда
			Свойство = Правило.Свойства.Найти("Комментарий", "СвойствоФормата");
			Если Свойство = Неопределено Тогда
				ДобавитьПКС(Правило.Свойства, "доп_Заметка", "Комментарий", 1, "");
			КонецЕсли;
			Правило.ПриОтправкеДанных = "Отправить";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&Вместо("ВыполнитьПроцедуруМодуляМенеджера")
Процедура Маршрутизировать(ИмяПроцедуры, Параметры)
	Если ИмяПроцедуры = "СохранитьЗначение" Тогда
		СохранитьЗначение(Параметры.ПолученныеДанные, Параметры.ДанныеИБ,
			Параметры.КонвертацияСвойств, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "Отправить" Тогда
		Отправить(Параметры.ДанныеИБ, Параметры.ДанныеXDTO,
			Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "Преобразовать" Тогда
		Преобразовать(Параметры.ДанныеXDTO, Параметры.ПолученныеДанные, Параметры.КомпонентыОбмена);
	ИначеЕсли ИмяПроцедуры = "ПередЗаписью" Тогда
		ПередЗаписью(Параметры.ПолученныеДанные, Параметры.ДанныеИБ,
			Параметры.КонвертацияСвойств, Параметры.КомпонентыОбмена);
	Иначе
		ПродолжитьВызов(ИмяПроцедуры, Параметры);
	КонецЕсли;
КонецПроцедуры

Процедура СохранитьЗначение(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отсутствующие = "";
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство(
		"СвойстваОтсутствующиеВПолученныхДанных", Отсутствующие) Тогда
		Имена = СтрРазделить(Отсутствующие, ",", Ложь);
		Для Индекс = 0 По Имена.ВГраница() Цикл
			Имена[Индекс] = СокрЛП(Имена[Индекс]);
		КонецЦикла;
		Если Имена.Найти("Комментарий") <> Неопределено Тогда
			Если Имена.Найти("доп_Заметка") = Неопределено Тогда
				Имена.Добавить("доп_Заметка");
				ПолученныеДанные.ДополнительныеСвойства.Вставить(
					"СвойстваОтсутствующиеВПолученныхДанных", СтрСоединить(Имена, ","));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура Отправить(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	СтарыйОтправитель(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки);
	Если ДанныеXDTO <> Неопределено Тогда
		ДанныеXDTO.Вставить("Комментарий", ВРег(ДанныеИБ.доп_Заметка));
	КонецЕсли;
КонецПроцедуры

Процедура Преобразовать(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	СтарыйПреобразователь(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена);
	Если ПолученныеДанные <> Неопределено Тогда
		Значение = "";
		Если ДанныеXDTO.Свойство("Комментарий", Значение) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("доп_Заметка", ВРег(Значение));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	СтарыйПисатель(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена);
	Если ПолученныеДанные <> Неопределено Тогда
		ПолученныеДанные.доп_Заметка = СокрЛП(ПолученныеДанные.доп_Заметка);
	КонецЕсли;
КонецПроцедуры
