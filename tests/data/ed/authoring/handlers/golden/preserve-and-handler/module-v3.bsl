// Сформировано из решений автора. Заголовочный проход не изменяет правила.
&После("ЗаполнитьПравилаКонвертацииОбъектов")
Процедура доп_ЗаполнитьПравилаКонвертацииОбъектов(КомпонентыОбмена, ПравилаКонвертации, ТолькоЗаголовки)

	Если Не ТолькоЗаголовки Тогда
		Если КомпонентыОбмена.НаправлениеОбмена = "Отправка" Тогда
			Правило = ПравилаКонвертации.Найти("Заказ", "ИмяПКО");
			Если Правило <> Неопределено Тогда
				Правило.ПриОтправкеДанных = "доп_ПКО_7ff9ee2e8e2dc3bc";
			КонецЕсли;
		КонецЕсли;
		Если КомпонентыОбмена.НаправлениеОбмена = "Получение" Тогда
			Правило = ПравилаКонвертации.Найти("Товар", "ИмяПКО");
			Если Правило <> Неопределено Тогда
				Свойство = Правило.Свойства.Найти("Комментарий", "СвойствоФормата");
				Если Свойство = Неопределено Тогда
					ДобавитьПКС(Правило.Свойства, "Заметка", "Комментарий");
				КонецЕсли;
				Правило.ПередЗаписьюПолученныхДанных = "доп_ПКО_f827df9e22fff383";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&Вместо("ВыполнитьПроцедуруМодуляМенеджера")
Процедура доп_Диспетчер(ИмяПроцедуры, Параметры)
	Если ИмяПроцедуры = "доп_ПКО_7ff9ee2e8e2dc3bc" Тогда
		доп_ПКО_7ff9ee2e8e2dc3bc(Параметры.ДанныеИБ, Параметры.ДанныеXDTO,
			Параметры.КомпонентыОбмена, Параметры.СтекВыгрузки);
	ИначеЕсли ИмяПроцедуры = "доп_ПКО_f827df9e22fff383" Тогда
		доп_ПКО_f827df9e22fff383(Параметры.ПолученныеДанные, Параметры.ДанныеИБ,
			Параметры.КонвертацияСвойств, Параметры.КомпонентыОбмена);
	Иначе
		ПродолжитьВызов(ИмяПроцедуры, Параметры);
	КонецЕсли;
КонецПроцедуры

Процедура доп_ПКО_7ff9ee2e8e2dc3bc(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
Возврат;
КонецПроцедуры

Процедура доп_ПКО_f827df9e22fff383(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	Если ПолученныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Отсутствующие = "";
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство(
		"СвойстваОтсутствующиеВПолученныхДанных", Отсутствующие) Тогда
		Имена = СтрРазделить(Отсутствующие, ",", Ложь);
		Для Индекс = 0 По Имена.ВГраница() Цикл
			Имена[Индекс] = СокрЛП(Имена[Индекс]);
		КонецЦикла;
		Если Имена.Найти("Комментарий") <> Неопределено Тогда
			Если Имена.Найти("Заметка") = Неопределено Тогда
				Имена.Добавить("Заметка");
				ПолученныеДанные.ДополнительныеСвойства.Вставить(
					"СвойстваОтсутствующиеВПолученныхДанных", СтрСоединить(Имена, ","));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
