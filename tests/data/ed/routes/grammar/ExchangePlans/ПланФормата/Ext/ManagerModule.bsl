Процедура ПриПолученииНастроек(Настройки) Экспорт
    Настройки.ЭтоПланОбменаXDTO = Истина;
    Настройки.ФорматОбмена = "urn:example:base";
    Настройки.ПравилаРегистрацииВМенеджере = Ложь;
    Настройки.Алгоритмы.ПриПолученииВариантовНастроекОбмена = Истина;
    Настройки.Алгоритмы.ПриПолученииОписанияВариантаНастройки = Истина;
    Расширения = Новый Соответствие;
    Расширения.Вставить("urn:example:plan", "1.2");
    Настройки.РасширенияФорматаОбмена = Расширения;
    Старая = Новый Соответствие;
    Алиас = Старая;
    Алиас.Вставить("0.9", МенеджерОбменаПример);
    Алиас = Новый Соответствие;
    Алиас.Вставить("0.8", МенеджерОбменаПример);
    Настройки.ВерсииФорматаОбмена = Старая;
    Карта = Новый Соответствие;
    Карта.Вставить("1.2", МенеджерОбменаПример);
    Карта.Вставить(" 1.4 ", МенеджерОбменаПример);
    Карта.Вставить("1.4", ДругойМенеджер);
    Псевдоним = Карта;
    Псевдоним.Вставить("1.5", МенеджерОбменаПример);
    Настройки.ВерсииФорматаОбмена = Карта;
    ПоставщикВерсий.Заполнить(Карта, "Особый");
КонецПроцедуры

Процедура Шум()
    // ВерсииФормата.Вставить("8.8", ЛожныйМодуль);
    Текст = "ВерсииФормата.Вставить(""7.7"", ЛожныйМодуль)";
КонецПроцедуры

Процедура ПриПолученииВариантовНастроекОбмена(ВариантыНастроекОбмена, ПараметрыКонтекста) Экспорт
    Если Метаданные.Имя <> "ВымышленнаяКонфигурация" Тогда
        СтрокаВарианта = ВариантыНастроекОбмена.Добавить();
        СтрокаВарианта.ИдентификаторНастройки = "Скрытый";
    КонецЕсли;
    Если ПараметрыКонтекста.ИмяКорреспондента = "ЧужаяБаза" Тогда
        СтрокаВарианта = ВариантыНастроекОбмена.Добавить();
        СтрокаВарианта.ИдентификаторНастройки = КодВариантаОсобый();
    Иначе
        СтрокаВарианта = ВариантыНастроекОбмена.Добавить();
        СтрокаВарианта.ИдентификаторНастройки = "Универсальный";
    КонецЕсли;
КонецПроцедуры

Функция КодВариантаОсобый()
    Возврат "Особый";
КонецФункции

Процедура ПриПолученииОписанияВариантаНастройки(Описание) Экспорт
    Текст = НСтр("ru = 'описание'");
КонецПроцедуры
