// Обезличенный пакет: ВТ, продолжения строк, параметры и чтение результатов.
Запрос = Новый Запрос;
Запрос.Текст =
"ВЫБРАТЬ
| Источник.Ссылка КАК Ссылка, ""текст;с точкой"" КАК Метка
|ПОМЕСТИТЬ ВТОбъекты
|ИЗ Документ.Пример КАК Источник
|ГДЕ Источник.Дата >= &Начало;
|// Разделитель в комментарии ; не создаёт часть
|ВЫБРАТЬ Ссылка ИЗ ВТОбъекты";
Запрос.УстановитьПараметр("Начало", НачалоДня(ДатаНачала));
Результат = Запрос.ВыполнитьПакет();
Таблица = Результат[1].Выгрузить();
Неизвестный = Результат[Номер].Выгрузить();
